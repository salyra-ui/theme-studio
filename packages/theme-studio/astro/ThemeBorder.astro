---
import { borderControlLabel, borderControlUnit } from '../core/border-control';
import {
  defaultTheme,
  type Theme,
  type Target,
  type BorderKind,
} from '../core';
interface Props {
  theme?: Theme;
  kind?: BorderKind;
  target?: Target;
  label?: string;
}
const {
  theme = defaultTheme,
  kind = 'width',
  target = 'DEFAULT',
  label = borderControlLabel(kind, target),
} = Astro.props;
---

<label class="tk-border">
  <span>{label}</span>
  <span class="tk-border-field">
    <input
      type="number"
      min="0"
      max="1000"
      step={kind === 'width' ? 1 : 0.125}
      value={theme.structure.websitePreset.border[kind][target]}
      data-tk-border={kind}
      data-target={target}
    />
    <span aria-hidden="true">{borderControlUnit(kind)}</span>
  </span>
</label>
<script>
  import './client';
</script>
