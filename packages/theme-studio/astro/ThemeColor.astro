---
import ThemeGenerator from './ThemeGenerator.astro';
import type { Theme, Role } from '../core';
interface Props {
  theme?: Theme;
  role?: Role;
  wheel?: boolean;
}
---

{Astro.slots.has('default') ? (
  <ThemeGenerator {...Astro.props}>
    <slot />
  </ThemeGenerator>
) : (
  <ThemeGenerator {...Astro.props} />
)}
