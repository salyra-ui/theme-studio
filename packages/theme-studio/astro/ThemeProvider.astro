---
import type { HTMLAttributes } from 'astro/types';
import type { AstroThemeOptions } from './options';
import ThemeRoot from './ThemeRoot.astro';
import ThemeVariableScope from './ThemeVariableScope.astro';
interface Props extends AstroThemeOptions {
  class?: string;
  style?: string;
  scopeProps?: HTMLAttributes<'div'>;
}
const {
  class: className = '',
  style = '',
  scopeProps = {},
  ...options
} = Astro.props;
---

<ThemeRoot {options}>
  <ThemeVariableScope
    {...scopeProps}
    {options}
    controlsBoundary
    class:list={['tk-scope', scopeProps.class, className]}
    style={`${scopeProps.style ?? ''};${style}`}
  >
    <slot />
  </ThemeVariableScope>
</ThemeRoot>
