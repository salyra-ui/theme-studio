{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": ".types-build",
    "rootDir": "packages"
  },
  "include": [
    "packages/*/core/**/*.ts",
    "packages/*/react/**/*.tsx",
    "packages/*/vanilla/**/*.ts"
  ]
}
